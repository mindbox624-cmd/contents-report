# 이 파일은 어떤 키가 필요한지 보여주는 견본이야. 실제 값은 여기 말고 .env에만 넣어.

# YouTube Data API v3 키 (Google Cloud Console에서 발급)
YOUTUBE_API_KEY=

# Notion 통합(integration) 토큰과 데이터를 쌓을 데이터베이스 ID
NOTION_TOKEN=
NOTION_DATABASE_ID=

# 이메일 발송용 Resend API 키 (resend.com에서 무료로 발급)
RESEND_API_KEY=

# 리포트를 받을 이메일 주소
REPORT_RECIPIENT_EMAIL=
